{
	"name": "@lc3/bot",
	"version": "1.0.0",
	"description": "Discord bot for the LC-3 simulator, running on Cloudflare Workers.",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"types": "wrangler types",
		"check": "tsc --noEmit",
		"register": "node cmd/register.js"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/node-fetch": "^2.6.13",
		"discord-api-types": "^0.38.56",
		"typescript": "^5.9.3",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@lc3/sim": "workspace:*",
		"node-fetch": "^3.3.2",
		"tweetnacl": "^1.0.3"
	},
	"engines": {
		"node": ">=v24.18.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.9.0"
}
